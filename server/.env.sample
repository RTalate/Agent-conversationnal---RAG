# Required: your OpenRouter API key (create one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Model used for every AI call: any model OpenRouter serves (https://openrouter.ai/models)
# LLM_MODEL=openai/gpt-4o-mini

# Database. By default the server starts and stops its own PostgreSQL (data in server/.data/postgres).
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=sqlgen
DB_HOST=127.0.0.1
DB_PORT=54329

# API port (the UI expects 3000)
PORT=3000

# Optional ---------------------------------------------------------------------------------------
# Use your own PostgreSQL instead (set DB_HOST, DB_PORT, DB_USER, DB_PASSWORD and DB_NAME above):
# DB_EMBEDDED=false
# Where the embedded PostgreSQL keeps its data:
# DB_DATA_DIR=/path/to/data
# Any OpenAI-compatible API instead of OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Do not ask the model for a JSON object, if a model or provider rejects it:
# LLM_JSON_MODE=false
# Role with SELECT-only privileges for the SQL written by the AI (see the README, "Sécurité"):
# DB_READONLY_USER=sqlgen_readonly
# DB_READONLY_PASSWORD=change_me

{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --require ts-node/register --test --test-timeout=300000 \"test/**/*.test.ts\"",
    "test:unit": "node --require ts-node/register --test --test-timeout=300000 \"test/unit/*.test.ts\"",
    "test:integration": "node --require ts-node/register --test --test-timeout=300000 \"test/integration/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "db:stop": "ts-node src/database-cli.ts stop",
    "db:reset": "ts-node src/database-cli.ts reset"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/pg": "^8.10.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.70.2",
    "pg": "^8.13.0"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "18.4.0-beta.17",
    "@embedded-postgres/darwin-x64": "18.4.0-beta.17",
    "@embedded-postgres/linux-arm": "18.4.0-beta.17",
    "@embedded-postgres/linux-arm64": "18.4.0-beta.17",
    "@embedded-postgres/linux-ia32": "18.4.0-beta.17",
    "@embedded-postgres/linux-ppc64": "18.4.0-beta.17",
    "@embedded-postgres/linux-x64": "18.4.0-beta.17",
    "@embedded-postgres/windows-x64": "18.4.0-beta.17"
  }
}
